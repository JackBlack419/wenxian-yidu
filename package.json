{
  "name": "wenxian-yidu",
  "type": "module",
  "version": "0.2.5",
  "description": "免费开源的 Zotero 中文文献翻译：双栏、段落对照、划词和输入翻译。",
  "config": {
    "addonName": "文献译读",
    "addonID": "wenxianyidu@wenxianyidu.local",
    "addonRef": "wenxianyidu",
    "addonInstance": "WenxianYidu",
    "prefsPrefix": "extensions.zotero.wenxianyidu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackBlack419/wenxian-yidu.git"
  },
  "homepage": "https://jackblack419.github.io/wenxian-yidu/",
  "bugs": { "url": "https://github.com/JackBlack419/wenxian-yidu/issues" },
  "author": "文献译读 contributors; based on z-transplit contributors",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "zotero-plugin serve",
    "build": "tsc --noEmit && zotero-plugin build",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:structure": "node scripts/structure-check.mjs",
    "check:jar": "node scripts/check-jar-provenance.cjs",
    "test:qa": "node --experimental-strip-types tests/qa/harness-smoke.mjs && node tests/qa/structure-check-selftest.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.13",
    "jsdom": "^29.1.1",
    "jszip": "3.10.2",
    "typescript": "^5.8",
    "vitest": "^4",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.2"
  }
}
